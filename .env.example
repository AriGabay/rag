# Copy to .env and change every password before running anywhere but a dev laptop.
# No secret belongs in git. The cloud API key stays on the server only.

POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
RAG_OWNER_PASSWORD=change-me-owner
RAG_APP_PASSWORD=change-me-app

# Session cookie signing/hash pepper (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# DEMO_MODE=true uses the labeled demo mock LLM when no office has a cloud provider enabled.
DEMO_MODE=true

# Embeddings: "local" (sentence-transformers, multilingual-e5-small) or "hash" (deterministic, non-semantic; tests/CI)
EMBEDDING_PROVIDER=local

# Optional cloud provider. Used only for offices whose admin enabled it. Keys stay on the server.
# LLM_PROVIDER selects openai (default) or anthropic.
# LLM_PROVIDER=openai
# OpenAI key: OPENAI_KEY wins; OPENAI_API_KEY is the fallback. Leave both empty in git.
OPENAI_KEY=
OPENAI_API_KEY=
# OPENAI_MODEL is the model of every purpose (default gpt-6-luna); set it to gpt-5.4-mini to switch them all.
# OPENAI_MODEL=gpt-6-luna
# Per purpose (agent, resolve, verify, measure, vision, summary): MODEL_<PURPOSE> overrides OPENAI_MODEL for that
# purpose, EFFORT_<PURPOSE> sets its reasoning effort (defaults: medium for agent; low for verify, measure and vision; none for
# resolve and summary). An effort the model does not accept stops the backend at startup.
# MODEL_VISION=gpt-6-luna
# EFFORT_VISION=low
# Chat output: at most one token-limit retry per turn, with twice the output budget and time left for verification.
CHAT_AGENT_OUTPUT_TOKENS=12000
LLM_TIMEOUT_AGENT_SECONDS=90
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Demo seed passwords (synthetic demo users only)
DEMO_PASSWORD=demo1234
